# Site root of pride.viralsakhiya.com — Task Mgnt now lives in /task/.
# Everything outside /task/ is sent there (old links like /tasks?task=… keep working as /task/tasks?task=…).
Options -MultiViews
RewriteEngine On

RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Leave alone: the app itself, SSL renewal checks, and the clean-up service worker below.
RewriteRule ^task(/|$) - [L]
RewriteRule ^\.well-known/ - [L]
RewriteRule ^sw\.js$ - [L]

RewriteRule ^(.*)$ /task/$1 [R=301,L]

<IfModule mod_headers.c>
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
