# --- React single-page app on Apache / cPanel ---
Options -MultiViews
RewriteEngine On

# Force HTTPS (remove these two lines if SSL is not set up yet)
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Serve real files/folders directly, send everything else to index.html
RewriteBase /
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

# Cache hashed assets for a long time, never cache index.html
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpg|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
